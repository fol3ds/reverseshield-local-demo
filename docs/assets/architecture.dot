
digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.65", fontname="DejaVu Sans", fontsize=11];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, penwidth=1.1, margin="0.18,0.12"];
  edge [color="#4B5563", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];

  subgraph cluster_in {
    label="Inputs"; fontsize=12; fontcolor="#0F172A"; color="#CBD5E1"; style="rounded,dashed";
    flatpak [label="Installed Flatpak\n(app payload)", fillcolor="#E0F2FE", color="#0284C7"];
    path    [label="Local folder / ELF / RPM", fillcolor="#E0F2FE", color="#0284C7"];
    upload  [label="Uploaded ELF / RPM", fillcolor="#E0F2FE", color="#0284C7"];
    samples [label="Bundled C samples", fillcolor="#E0F2FE", color="#0284C7"];
  }

  subgraph cluster_app {
    label="ReverseShield local workbench"; fontsize=12; fontcolor="#0F172A"; color="#94A3B8"; style="rounded";
    ui     [label="Browser UI\nOperate · Compare · Monitor", fillcolor="#0F172A", fontcolor="white", color="#0F172A"];
    api    [label="HTTP API\nloopback + session token", fillcolor="#155E75", fontcolor="white", color="#155E75"];
    jobs   [label="Job orchestration\ndiscovery · selections · events", fillcolor="#155E75", fontcolor="white", color="#155E75"];
    engine [label="Static analysis engine\nfile · readelf · objdump\nstrings · nm · Ghidra", fillcolor="#ECFEFF", color="#0891B2"];
    xform  [label="Sample-only transform\nstrip  |  demo blinding + gcc", fillcolor="#FEF3C7", color="#D97706"];
    report [label="Evidence store\nruns/<job_id>/", fillcolor="#F1F5F9", color="#64748B"];
  }

  flatpak -> api; path -> api; upload -> api; samples -> api;
  ui -> api [label="same origin"];
  api -> jobs -> engine;
  jobs -> xform [label="compare jobs"];
  engine -> report;
  xform -> engine [label="reanalyze"];
  report -> ui [label="report + artifacts"];

  {rank=same; flatpak; path; upload; samples}
}
